<% layout('/layouts/boilerplate') -%>

<main class="signup-page-wrapper">
    <div class="signup-card">
        <form action="/user/signup" method="POST" class="signup-form">
            <h2>Finish signing up</h2>
            <div class="divider"></div>
            
            <div class="input-field">
                <label for="username">Username</label>
                <input type="text" id="username" name="signup[username]" placeholder="Username" required>
            </div>

            <div class="input-field">
                <label for="email">Email</label>
                <input type="email" id="email" name="signup[email]" placeholder="Email address" required>
            </div>

            <div class="input-field">
                <label for="password">Password</label>
                <input type="password" id="password" name="signup[password]" placeholder="Password" required>
            </div>

            <p class="terms-text">
                We’ll send you marketing communications, notifications, and updates via email.
            </p>

            <button type="submit" class="submit-btn">Agree and continue</button>
        </form>
    </div>
</main>