<!-- header.ejs -->
<header class="hp-nav-container" id="hpNav">
  <div class="hp-nav-inner">

    <!-- Top Row: Logo + Categories + User Menu (Desktop & Tablet only) -->
    <div class="hp-nav-top desktop-only">
      <!-- Logo -->
      <div class="hp-logo">
        <a href="/listings">
          <img src="https://upload.wikimedia.org/wikipedia/commons/6/69/Airbnb_Logo_Bélo.svg" alt="Airbnb" />
        </a>
      </div>

      <!-- Categories -->
      <nav class="hp-categories">
        <div class="hp-nav-item active">Homes</div>
        <div class="hp-nav-item">Experiences</div>
        <div class="hp-nav-item">Services</div>
      </nav>

      <!-- User Menu (Login/Signup/Logout) - Desktop only -->
      <div class="hp-user-menu">
        <% if (typeof currUser === 'undefined' || !currUser) { %>
          <a href="/user/signup" class="hp-auth-link signup-btn">Sign up</a>
          <a href="/user/login" class="hp-auth-link login-btn">Log in</a>
        <% } else { %>
          <div class="hp-profile-box">
            <form action="/user/logout" method="POST" style="margin:0;">
              <button type="submit" class="logout-btn">Logout</button>
            </form>
            <div class="hp-avatar">
              <i class="fa-solid fa-user"></i>
            </div>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Search Bar -->
    <div class="hp-search-wrapper">
      <!-- Desktop & Tablet: Full Search (Where | When | Who) -->
      <form class="hp-search-form desktop-search" action="/search" method="GET">
        <div class="hp-search-input-group">
          <label>Where</label>
          <input type="text" name="location" placeholder="Search destinations" required />
        </div>
        <div class="hp-v-divider"></div>
        <div class="hp-search-input-group">
          <label>When</label>
          <input type="text" name="dates" placeholder="Add dates" />
        </div>
        <div class="hp-v-divider"></div>
        <div class="hp-search-input-group">
          <label>Who</label>
          <input type="text" name="guests" placeholder="Add guests" />
        </div>
        <button type="submit" class="hp-search-btn">
          <i class="fa-solid fa-magnifying-glass"></i>
        </button>
      </form>

      <!-- Mobile: Simple Attractive Search Pill -->
      <form class="hp-search-form mobile-search" action="/search" method="GET">
        <div class="hp-mobile-search-pill">
          <i class="fa-solid fa-magnifying-glass"></i>
          <input type="text" name="location" placeholder="Where are you going?" required />
        </div>
      </form>
    </div>

  </div>
</header>

<!-- Mobile Bottom Navigation -->
<div class="mobile-bottom-nav">
  <a href="/listings" class="mobile-nav-item active">
    <i class="fa-solid fa-magnifying-glass"></i>
    <span>Explore</span>
  </a>
  <a href="#" class="mobile-nav-item">
    <i class="fa-regular fa-heart"></i>
    <span>Wishlists</span>
  </a>

  <% if (typeof currUser === 'undefined' || !currUser) { %>
    <!-- Not Logged In -->
    <a href="/user/login" class="mobile-nav-item">
      <i class="fa-regular fa-circle-user"></i>
      <span>Log in</span>
    </a>
  <% } else { %>
    <!-- Logged In - Show Logout -->
    <form action="/user/logout" method="POST" class="mobile-nav-item logout-form">
      <button type="submit">
        <i class="fa-solid fa-arrow-right-from-bracket"></i>
        <span>Logout</span>
      </button>
    </form>
  <% } %>
</div>
<script>
  const nav = document.getElementById('hpNav');
  
  window.addEventListener('scroll', () => {
    if (window.scrollY > 20) {
      nav.classList.add('scrolled');
    } else {
      nav.classList.remove('scrolled');
    }
  });
</script>